{
  "name": "react-multistyle-ui",
  "version": "0.0.2",
  "description": "A multi-style, multi-theme React 18 component library with multiple design styles and multiple color schemes (port of svelte-multistyle-ui)",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "react-multistyle-ui": "cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./theme.css": "./dist/components/theme.css",
    "./theme-base.css": "./dist/components/theme-base.css",
    "./themes": "./dist/themes/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "cli",
    "!cli/**/*.test.*",
    "!cli/test.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "gen:theme": "node scripts/gen-theme.js",
    "gen": "node cli/bin.js generate",
    "gen:sample": "node cli/bin.js generate --input cli/fixtures/sample.yaml --output ./src/routes/demo/App.tsx --dry-run",
    "test:gen": "node cli/test.js",
    "build:lib": "pnpm run gen:theme && vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json && node scripts/copy-assets.js",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install --with-deps chromium webkit"
  },
  "peerDependencies": {
    "chart.js": "^4.5.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.21",
    "js-yaml": "^4.1.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "keywords": [
    "react",
    "react18",
    "components",
    "ui-library",
    "material-design",
    "glassmorphism",
    "neumorphism",
    "brutalist",
    "cyberpunk",
    "multi-theme",
    "multi-style"
  ]
}
