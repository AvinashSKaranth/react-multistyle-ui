# Runtime / generated demo
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Env / secrets
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

