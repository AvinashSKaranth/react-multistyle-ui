.codegraph/tmp/
.serena/cache/

# Optional npm/yarn integrity sidecars (pnpm keeps its own)
.npm/
.yarn/cache
.yarn/build-state.yml
.yarn/install-state.gz

# Misc
*.tgz
.history/
